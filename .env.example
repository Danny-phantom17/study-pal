# Required AI tutor key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Google Sheets persistence for legacy points, attendance, and sheet-hosted questions.
# Easiest no-card option: deploy docs/apps-script/Code.gs and paste the Web App URL here.
APPS_SCRIPT_WEB_APP_URL=

# Optional advanced Google Sheets service account credentials.
GOOGLE_SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# StudyPal bot settings
BOT_COMMAND_PREFIX=!
QUIZ_QUESTION_COUNT=20
QUIZ_TIME_LIMIT_SECONDS=30
POINTS_PER_CORRECT_ANSWER=10
FREE_DAILY_QUIZ_LIMIT=2
FREE_FOLLOWUPS_PER_QUESTION=3
FREE_REVIEW_LIMIT=5

# Community reminders and admin copy
STUDY_GROUP_CHAT_ID=
ADMIN_WHATSAPP_NUMBER=
REMINDER_START_HOUR=14

# WhatsApp Web / Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=
WWEBJS_AUTH_DIR=.wwebjs_auth
STUDYPAL_DB_PATH=data/studypal.db

# Optional internet question lookup.
# Recommended: point this to your own vetted JAMB/WAEC question API.
JAMB_QUESTION_API_URL=

# Optional fallback: Google Programmable Search API.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
