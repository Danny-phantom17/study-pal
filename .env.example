# Easiest no-card option: deploy the Google Apps Script in docs/apps-script/Code.gs
# and paste the Web App URL here.
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/AKfycbw5ySP_sITVzbQvMzhmuuWEhS9jYJH5Gs-UhDK9BKtIDl4CJIcz63Iw8CvQUzAZObpd/exec

# Optional advanced option: service account credentials.
GOOGLE_SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional bot settings
QUIZ_TIME_LIMIT_SECONDS=30
POINTS_PER_CORRECT_ANSWER=1.67
BOT_COMMAND_PREFIX=!
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional internet question lookup.
# Recommended: point this to your own vetted JAMB question API.
JAMB_QUESTION_API_URL=

# Optional fallback: Google Programmable Search API.
# Create an API key and search engine at https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
